# Bibliothèque universitaire — configuration Apache

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Le site ne doit pas être affiché dans un cadre d'un autre site (boutons « Réserver », formulaires)
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>

# Pas de JavaScript dans les SVG ouverts directement
<FilesMatch "\.svg$">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "script-src 'none'"
  </IfModule>
</FilesMatch>

# Fichiers sensibles : jamais servis
<FilesMatch "(^\.|\.(sql|md|log|bak|ini|txt|ps1|sh)$|^composer\.(json|lock)$|^error_log$)">
  Require all denied
</FilesMatch>
<FilesMatch "^robots\.txt$">
  Require all granted
</FilesMatch>

# Dossiers cachés (.git, .svn…) : introuvables, même sans mod_rewrite
RedirectMatch 404 (?i)/\.(?!well-known/)[^/]+(/|$)

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Aucun script exécutable dans les images envoyées, y compris avec un chemin ajouté (x.php/y.jpg)
  RewriteRule ^images/.*\.(php\d?|phtml|phar|pl|py|cgi)(/|$) - [F,NC]
  # Le code, les vues et l'installation ne sont pas accessibles depuis le web
  RewriteRule ^(app|views|install)(/|$) - [F,NC]
</IfModule>

# Mise en cache des ressources statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 90 days"
  ExpiresByType font/woff "access plus 90 days"
  ExpiresByType font/ttf "access plus 90 days"
</IfModule>
<IfModule !mod_expires.c>
  <IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|eot|png|jpe?g|gif|webp|svg|ico)$">
      Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
  </IfModule>
</IfModule>
