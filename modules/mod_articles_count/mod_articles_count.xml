<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5.0" method="upgrade" client="site">
  <name>Articles Count</name>
  <author>Fiona Coulter</author>
  <creationDate>4 September 2013</creationDate>
  <copyright>Inspiration Web Design</copyright>
  <license>GPL</license>
  <authorEmail>joomla-at-iswebdesign.co.uk</authorEmail>
  <authorUrl>www.iswebdesign.co.uk</authorUrl>
  <version>3.0.2</version>
  <description>Articles Count Module - counts articles in categories and displays a link</description>
  <files>
    <filename module="mod_articles_count">mod_articles_count.php</filename>
    <filename>helper.php</filename>
    <filename>index.html</filename>
    <folder>tmpl</folder>
    <folder>css</folder>
  </files>
  <config>
    <fields name="params">
      <fieldset name="basic" label="Module Parameters" description="Configure Module">
        <field name="catid" type="category" extension="com_content" show_root="true" multiple="multiple" default="" label="Category ID" description="ARTCOUNTCATEGORYID" size="12"/>
        <field name="contact_catid" type="category" extension="com_contact" show_root="true" multiple="multiple" default="" label="Contact Category ID" description="ARTCOUNTCATEGORYID" size="12"/>
        <field name="newsfeeds_catid" type="category" extension="com_newsfeeds" show_root="true" multiple="multiple" default="" label="Newsfeeds Category ID" description="ARTCOUNTCATEGORYID" size="12"/>
        <field name="weblinks_catid" type="category" extension="com_weblinks" show_root="true" multiple="multiple" default="" label="Weblinks Category ID" description="ARTCOUNTCATEGORYID" size="12"/>
		<field name="extension" type="list" default="com_content" multiple="multiple" label="Extension" description="Choose core extensions to show categories for">
		  <option value="com_content">com_content</option>
		  <option value="com_contact">com_contact</option>
		  <option value="com_newsfeeds">com_newsfeeds</option>
		  <option value="com_weblinks">com_weblinks</option>
		</field>
        <field name="use_request" type="radio" default="no" label="Use Current Category" description="ARTCOUNTUSEREQUEST">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>
        <field name="show_unpublished" type="radio" default="no" label="Show unpublished articles" description="ARTCOUNTSHOWUNPUBLISHED">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>
        <field name="link_cat" type="radio" default="yes" label="Link to Category" description="ARTCOUNTLINKCATEGORY">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>
        <field name="menuitemid" type="menuitem" menu_type="" default="" label="Select a menu item" description="ARTCOUNTMENUITEM" />			
        <field name="show_no_access_categories" type="radio" default="no" label="Show no access categories" description="ARTCOUNTSHOWNOACCESSCATEGORIES">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>	
        <field name="show_no_access_articles" type="radio" default="no" label="Show no access articles" description="ARTCOUNTSHOWNOACCESSARTICLES">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>	
        <field name="show_child" type="radio" default="no" label="Show Child Categories" description="ARTCOUNTSHOWCHILDCATEGORIES">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>	
        <field name="show_parent" type="radio" default="no" label="Show Parent Categories" description="ARTCOUNTSHOWPARENTCATEGORIES">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>			
        <field name="show_empty" type="radio" default="yes" label="Show Empty Categories" description="ARTCOUNTSHOWEMPTY">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>	
        <field name="show_zero_blank" type="radio" default="yes" label="Show Zero as Blank" description="ARTCOUNTSHOWZEROBLANK">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>
        <field name="show_cumul" type="radio" default="no" label="Show Cumulative Totals" description="ARTCOUNTSHOWCUMUL">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>																																																				
        <field name="show_tree" type="radio" default="no" label="Show Tree" description="ARTCOUNTSHOWTREE">
          <option value="no">No</option>
          <option value="yes">Yes</option>
        </field>																		
      </fieldset>
      <fieldset name="advanced" label="Advanced Parameters" description="Configure Module">
        <field name="moduleclass_sfx" type="text" default="" label="Module Class Suffix" description="ARTCOUNTMODULECLASSSUFFIX" />
        <field name="cache" type="list" default="1" label="Caching" description="Select whether to cache the content of this module">
          <option value="1">Use global</option>
          <option value="0">No caching</option>
        </field>
        <field name="cache_time" type="text" default="900" label="Cache Time" description="The time before the module is recached" />
      </fieldset>
    </fields>
  </config>
  <languages>
    <language tag="en-GB">en-GB.mod_articles_count.ini</language>
  </languages>
    <updateservers>
        <server type="extension" priority="1" name="Articles Count">http://spiralextensions.co.uk/updates/articlescount.xml</server>
    </updateservers>			    
</extension>
