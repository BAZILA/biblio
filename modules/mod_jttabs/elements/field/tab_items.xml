<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="tab_items" class="tab-items">
	<field name="TabType" type="list" default="modules" label="MOD_JT_TABS_TABTYPE" description="MOD_JT_TABS_TABTYPE_DESC" >
		    <option value="modules">MOD_JT_TABS_MODULE</option>
			<option value="articles">MOD_JT_TABS_ARTICLE</option>
		</field>
	<field name="id" type="sql" multiple="true" size="10"
				label="MOD_JT_TABS_MODULE"
				showon="TabType:modules"
				description="MOD_JT_TABS_MODULE_DESC"
				query="SELECT id, module, position, title FROM #__modules WHERE published=1 AND client_id=0 ORDER BY title"
				key_field="id" value_field="title">
				<option value="">Select Modules</option>
			</field>

	<field name="article" class="form-select"
                          label="MOD_JT_TABS_FIELD_ARTICLE"
						  showon="TabType:articles"
                          description="MOD_JT_TABS_FIELD_ARTICLE_DESC"
                          type="articles" />
		<field name="tabtitle" type="text" size="60" default="" label="MOD_JT_TABS_NAME" description="MOD_JT_TABS_NAME_DESC" />
		<field name="tabpanelwidth" type="text" showon="TabType:articles" size="60" default="100%" label="MOD_JT_TABS_TABPANELWIDTH" description="MOD_JT_TABS_TABPANELWIDTH_DESC" />
		<field name="tabpanelheight" type="text" showon="TabType:articles" size="60" default="auto" label="MOD_JT_TABS_TABPANELHEIGHT" description="MOD_JT_TABS_TABPANELHEIGHT_DESC" />
		
	</fieldset>
</form>
